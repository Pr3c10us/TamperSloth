# Copy to .env.local for development. Every value is optional.

# The TamperSloth API the pricing page talks to; defaults to https://api.tampersloth.com.
VITE_TAMPERSLOTH_API_URL=http://localhost:5000
# Paddle client-side token (test_... in sandbox, live_... in production). Without it the
# pricing page shows prices but can't open checkout.
VITE_PADDLE_CLIENT_TOKEN=
# "sandbox" or "production" (the default).
VITE_PADDLE_ENV=sandbox
