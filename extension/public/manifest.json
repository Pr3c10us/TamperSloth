{
  "name": "TamperSloth puts an AI agent to work on every page you browse",
  "short_name": "TamperSloth",
  "description": "Put your browser to work.",
  "version": "3.2",
  "manifest_version": 3,
  "minimum_chrome_version": "138",
  "action": {
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open TamperSloth in this tab"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": [
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "tabs",
    "tabGroups",
    "activeTab",
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "userScripts",
    "alarms",
    "cookies",
    "debugger",
    "downloads",
    "notifications",
    "clipboardRead",
    "clipboardWrite",
    "offscreen",
    "contextMenus",
    "identity"
  ],
  "host_permissions": ["<all_urls>"],
  "oauth2": {
    "client_id": "115683893748-p0acp04vpq4ivqim5p747dqn95gp2fti.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "web_accessible_resources": [
    {
      "resources": ["index.html", "favicon.svg", "fonts/geist-latin-wght-normal.woff2", "fonts/instrument-serif-latin-400-italic.woff2"],
      "matches": ["<all_urls>"]
    }
  ]
}
