# Copy to .env.local for development. Every value is optional: leave one unset and the
# build points at the hosted TamperSloth services.

# The TamperSloth API that sign-in and the Sloth models talk to.
VITE_TAMPERSLOTH_API_URL=http://localhost:5000
# The website whose /pricing page "Upgrade" opens.
VITE_TAMPERSLOTH_SITE_URL=http://localhost:5180
# A Google "Web application" OAuth client for sign-in in browsers without
# chrome.identity.getAuthToken (Edge, Brave...). Its redirect URI is chrome.identity.getRedirectURL().
VITE_GOOGLE_WEB_CLIENT_ID=
