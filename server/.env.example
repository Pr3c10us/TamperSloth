# Copy to .env and fill in. Variables marked (required) stop the server at startup when missing.

# ---------- HTTP ----------
PORT=5000
# Comma-separated origins allowed by CORS: the landing page (pricing) in dev and production.
CLIENT_ORIGIN=http://localhost:5180
# (required) Comma-separated Chrome extension IDs allowed by CORS. Load the unpacked
# extension, copy its ID from chrome://extensions, and put it here.
EXTENSION_IDS=

# ---------- Auth ----------
# (required) Long random strings, e.g. `openssl rand -hex 32`. Use a different one for each.
JWT_SECRET=
REFRESH_JWT_SECRET=
BILLING_TOKEN_SECRET=
# Lifetimes in seconds.
JWT_EXPIRES=604800
REFRESH_JWT_EXPIRES=2592000
# (required) Comma-separated Google OAuth client IDs whose ID tokens sign users in:
# the Chrome extension client in manifest.json, plus the web client if you set one.
GOOGLE_EXTENSION_CLIENT_ID=

# ---------- Postgres ----------
# (required) compose.yaml creates this database and user for you.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=tampersloth
POSTGRES_USER=tampersloth
POSTGRES_PASSWORD=
POSTGRES_SSL=false

# ---------- Redis ----------
# (required) Rate limits, credits and the global spend limit live here.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_TLS=false

# ---------- Sloth models ----------
# The Anthropic key behind the hosted "Sloth" models. Leave empty to run without them.
ANTHROPIC_API_KEY=
# Token budget for a single agent run, per plan (0 = unlimited).
FREE_RUN_TOKEN_BUDGET=500000
GO_RUN_TOKEN_BUDGET=2000000
PRO_RUN_TOKEN_BUDGET=0
# Credits shown to users per US dollar of model spend.
CREDITS_PER_USD=10
# Optional monthly Sloth credit in US dollars per plan; unset uses the built-in amounts.
FREE_MONTHLY_CREDIT_USD=
GO_MONTHLY_CREDIT_USD=
PRO_MONTHLY_CREDIT_USD=

# ---------- Email ----------
# (required) SMTP for spend and billing alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# Where the global daily spend limit alerts go; defaults to SMTP_FROM_ADDRESS.
SPEND_ALERT_EMAIL=

# ---------- Billing (Paddle) ----------
# Leave all of these empty to run without billing; the billing routes answer 503.
# Set any of them and all must be set and consistent, or the server refuses to start.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Comma-separated Paddle price ids (pri_...) per paid plan; checkout sells the first.
PADDLE_PRICE_GO=
PADDLE_PRICE_PRO=

# ---------- compose.yaml only ----------
# Host ports for the bundled Postgres and Redis containers.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
